{
  "manifest_version": 3,
  "name": "Flag of Convenience",
  "version": "2.4.1",
  "description": "Shows the flag of the country your traffic appears to come from, an at-a-glance VPN and proxy check in your toolbar.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["alarms", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Flag of Convenience",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
